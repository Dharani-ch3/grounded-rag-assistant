# Which model writes answers: offline (extractive, no model) | openai | anthropic | bedrock | ollama
ASSISTANT_PROVIDER=offline
# Embeddings: hashing (local, free) | openai | bedrock | ollama
ASSISTANT_EMBEDDER=hashing
# Vector store: memory | pinecone | weaviate
ASSISTANT_VECTOR_STORE=memory
# Let the model choose graph intents (from a fixed menu). Rules are used when off.
ASSISTANT_LLM_ROUTER=false
# Folder with directory.json, documents/ and eval sets
# ASSISTANT_KNOWLEDGE_PATH=./knowledge
# Append every question, approval and edit to a JSONL audit file
# ASSISTANT_AUDIT_PATH=data/audit.jsonl

# Auth: KEY:user_id pairs. Empty = demo mode, where the caller names the user (never expose that publicly).
ASSISTANT_API_KEYS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=   # required for the anthropic provider: an Anthropic model id

# Amazon Bedrock (uses the normal AWS credential chain)
AWS_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-micro-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
WEAVIATE_URL=
WEAVIATE_API_KEY=
